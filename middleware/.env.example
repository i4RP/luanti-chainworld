# ChainWorld Middleware Configuration

# Database (SQLite path)
CHAINWORLD_DATABASE_URL=sqlite+aiosqlite:///chainworld.db

# Blockchain RPC
CHAINWORLD_CHAIN_RPC_URL=http://127.0.0.1:8545
CHAINWORLD_CHAIN_ID=31337
CHAINWORLD_CONTRACT_ADDRESS=
CHAINWORLD_PRIVATE_KEY=

# Middleware settings
CHAINWORLD_BATCH_COMMIT_INTERVAL=30
CHAINWORLD_MAX_BATCH_SIZE=500

# CORS
CHAINWORLD_CORS_ORIGINS=["*"]
